# ============================================================
# 星曜奇门 · .gitignore
# 密钥与凭据：绝不入库
# ============================================================

# ---- 签名密钥与口令（绝不公开）----
密钥/
*.jks
*.keystore
*.key
*.pem
密码.txt
*密码*

# ---- 构建产物 ----
app/out/
app/build/
*.apk

# ---- 归档、成品图与设计稿（不进开源仓库）----
存档/
成品/
设计-*/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
Desktop.ini
*~
*.bak
*.swp
*.swo
.idea/
.vscode/

# ---- 内部工作文档（含环境路径与内部细节，不入库）----
项目记录.md
工作交接.md
交接-*.md

# ---- 设计稿（目录与文件两种形态：web/设计-排法卡.html 曾漏网）----
设计-*

# ---- Python 缓存 ----
__pycache__/
*.pyc
